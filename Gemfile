source "https://rubygems.org"

# Matches the Jekyll 3.9 line used by GitHub Pages' built-in builder.
gem "jekyll", "~> 3.9.0"

# Jekyll 3.9 needs webrick on Ruby 3.x for `jekyll serve`.
gem "webrick", "~> 1.8"

# GitHub-flavoured Markdown (kramdown input: GFM)
gem "kramdown-parser-gfm", "~> 1.1"

group :jekyll_plugins do
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-redirect-from", "~> 0.16"
end
